aws_region = "us-east-1"
environment = "dev"
project_name = "microservices-ingress"
admin_cidr_blocks = ["REPLACE_WITH_YOUR_PUBLIC_IP/32"]
eks_public_access_cidrs = ["REPLACE_WITH_YOUR_PUBLIC_IP/32"]
jenkins_instance_type = "t3.large"
monitoring_instance_type = "t3.medium"
eks_cluster_version = "1.31"
eks_node_instance_types = ["t3.medium"]
eks_desired_size = 2
eks_min_size = 2
eks_max_size = 4
enable_nat_gateway = true
enable_optional_alb = false
enable_optional_rds = false
# key_name = "your-existing-ec2-keypair"
